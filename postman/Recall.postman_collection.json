            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"400 invalid rating\", () => pm.response.to.have.status(400));"] }
            }
          ]
        },
        {
          "name": "Bulk import (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{apiPrefix}}/topics/{{newTopicId}}/cards/import", "host": ["{{apiPrefix}}"], "path": ["topics", "{{newTopicId}}", "cards", "import"] },
            "body": { "mode": "raw", "raw": "{\n  \"cards\": [\n    { \"question\": \"Q1\", \"answer\": \"A1\" },\n    { \"question\": \"Q2\", \"answer\": \"A2\" },\n    { \"question\": \"Q3\", \"answer\": \"A3\" }\n  ]\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"201 import\", () => pm.response.to.have.status(201));"] }
            }
          ]
        },
        {
          "name": "Import with invalid row (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{apiPrefix}}/topics/{{newTopicId}}/cards/import", "host": ["{{apiPrefix}}"], "path": ["topics", "{{newTopicId}}", "cards", "import"] },
            "body": { "mode": "raw", "raw": "{\n  \"cards\": [\n    { \"question\": \"\", \"answer\": \"empty question\" }\n  ]\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"400 row error\", () => pm.response.to.have.status(400));"] }
            }
          ]
        },
        {
          "name": "401 without token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{apiPrefix}}/courses", "host": ["{{apiPrefix}}"], "path": ["courses"] },
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"NOPE\",\n  \"title\": \"Nope\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"401 unauthenticated\", () => pm.response.to.have.status(401));"] }
            }
          ]
        },
        {
          "name": "Cleanup: list imported cards",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{apiPrefix}}/topics/{{newTopicId}}/cards?pageSize=100", "host": ["{{apiPrefix}}"], "path": ["topics", "{{newTopicId}}", "cards"], "query": [{ "key": "pageSize", "value": "100" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test(\"200 card list for cleanup\", () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set(\"cleanupCardIds\", JSON.stringify((pm.response.json().data || []).map(c => c.id)));"
              ] }
            }
          ]
        },
        {
          "name": "Cleanup: delete topic (204 after emptying)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{apiPrefix}}/topics/{{newTopicId}}", "host": ["{{apiPrefix}}"], "path": ["topics", "{{newTopicId}}"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Delete the cards listed by the previous request first, so the topic delete returns 204.",
                "const ids = JSON.parse(pm.collectionVariables.get(\"cleanupCardIds\") || \"[]\");",
                "const auth = { Authorization: `Bearer ${pm.collectionVariables.get(\"accessToken\")}` };",
                "ids.forEach(id => pm.sendRequest({ url: pm.variables.replaceIn(`{{apiPrefix}}/cards/${id}`), method: \"DELETE\", header: auth },",
                "  (err, res) => { if (err || res.code !== 204) console.log(`card ${id} delete: ${err || res.code}`); }));"
              ] }
            },
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"204 topic deleted\", () => pm.response.to.have.status(204));"] }
            }
          ]
        },
        {
          "name": "Cleanup: delete course (204 after emptying)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{apiPrefix}}/courses/{{newCourseId}}", "host": ["{{apiPrefix}}"], "path": ["courses", "{{newCourseId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"204 course deleted\", () => pm.response.to.have.status(204));"] }
            }
          ]
        },
        {
          "name": "Logout (204)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{apiPrefix}}/auth/logout", "host": ["{{apiPrefix}}"], "path": ["auth", "logout"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"204 logout\", () => pm.response.to.have.status(204));"] }
            }
          ]
        }
      ]
    }
  ]
}